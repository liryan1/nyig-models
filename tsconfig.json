{
  "compilerOptions": {
    "target": "ES2022",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
